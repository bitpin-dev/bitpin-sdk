{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bitpin API spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "urls", "constants", "rate_limits", "endpoints", "errors", "has", "not_supported", "ws"],
  "properties": {
    "version": { "const": 1 },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rest", "ws", "docs"],
      "properties": {
        "rest": { "type": "string", "pattern": "^https://" },
        "ws": { "type": "string", "pattern": "^wss://" },
        "docs": { "type": "string", "pattern": "^https://" }
      }
    },
    "constants": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "rate_limits": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit", "period"],
        "properties": {
          "limit": { "type": "integer", "minimum": 1 },
          "period": { "enum": ["sec", "min", "hour", "day"] }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "propertyNames": { "pattern": "^(public|private|credentials)_(get|post|delete)_[a-z0-9_]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "auth", "buckets", "idempotent", "docs"],
        "properties": {
          "method": { "enum": ["GET", "POST", "DELETE"] },
          "path": { "type": "string", "pattern": "^/api/v[0-9]+/[a-z0-9_/{}-]+/$" },
          "auth": { "enum": ["public", "private", "credentials"] },
          "buckets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "idempotent": { "type": "boolean" },
          "docs": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "error"],
        "properties": {
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "paths": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "array", "items": { "type": "string" } },
          "error": {
            "enum": ["ExchangeError", "AuthenticationError", "PermissionDenied", "InsufficientFunds", "InvalidOrder", "OrderNotFound", "BadRequest", "InvalidOTP", "RateLimitExceeded", "ExchangeNotAvailable"]
          }
        }
      }
    },
    "has": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "not_supported": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "fa"],
        "properties": { "en": { "type": "string" }, "fa": { "type": "string" } }
      }
    },
    "ws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "events"],
      "properties": {
        "channels": { "type": "object", "additionalProperties": { "type": "string" } },
        "events": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
