{
  "name": "bitpin-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Bitpin exchange API (REST + WebSocket), ccxt-shaped",
  "license": "MIT",
  "author": "Bitpin",
  "homepage": "https://bitpin-dev.github.io/bitpin-sdk/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitpin-dev/bitpin-sdk.git",
    "directory": "ts"
  },
  "bugs": "https://github.com/bitpin-dev/bitpin-sdk/issues",
  "keywords": [
    "bitpin",
    "crypto",
    "exchange",
    "trading",
    "sdk",
    "ccxt",
    "market-making"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:live": "vitest run -c vitest.live.config.ts"
  },
  "dependencies": {
    "centrifuge": "5.8.0",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9",
      "onFail": "error"
    }
  }
}
